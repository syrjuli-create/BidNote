@using BidNote.Application.Favorites
@using BidNote.Application.Home
@inject IFavoriteStore Store
@inject ILogger<NoticeTable> Logger

@* 공고 목록 표. 별 버튼이 실시간 연결 하나를 같이 쓰도록 표 전체를 한 구성요소로 둔다
   (별마다 따로 연결하면 200줄에서 연결이 끊겼다). *@
<div class="tbl">
    <table>
        <thead>
            <tr><th class="starcol"><span class="sr">관심</span></th><th>마감</th><th>공고명 · 발주기관</th><th>지역·업종</th><th class="r">기초금액</th><th>마감 일시</th></tr>
        </thead>
        <tbody>
            @foreach (var n in Items)
            {
                bool on = favorites.Contains(n.Id);
                <tr>
                    <td class="starcol">
                        <button type="button" class="star @(on ? "on" : "")" aria-pressed="@(on ? "true" : "false")"
                                title="@(on ? "관심 공고에서 빼기" : "관심 공고에 담기")" aria-label="@(on ? "관심 공고에서 빼기" : "관심 공고에 담기")"
                                disabled="@(busy == n.Id)" @onclick="() => ToggleAsync(n.Id)">★</button>
                    </td>
                    <td class="ddaycol"><span class="dday @Display.DDayLevel(n.DueAt, Now)">@Display.DDay(n.DueAt, Now)</span></td>
                    <td class="namecol">
                        <a class="tname" href="/notices/@n.Id">@n.Name</a>
                        @if (n.CorrectionCount > 0) { <span class="chip warn">정정 @(n.CorrectionCount)차</span> }
                        @if (n.PostedAt >= Now - HomeRules.NewWindow) { <span class="chip new">새 공고</span> }
                        <span class="tsub">@n.Agency · <span class="num">@n.BidNo</span></span>
                    </td>
                    <td class="nw">@n.Region<span class="tsub">@n.License</span></td>
                    <td class="r num">@Display.Eok(n.BasePrice)</td>
                    <td class="num nw">@Display.ShortDateTime(n.DueAt)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NoticeListItem> Items { get; set; } = [];
    [Parameter] public int[] FavoriteIds { get; set; } = [];
    [Parameter] public DateTime Now { get; set; }

    private HashSet<int> favorites = [];
    private int? busy;
    private bool initialized;

    protected override void OnParametersSet()
    {
        if (initialized) return;
        favorites = [.. FavoriteIds];
        initialized = true;
    }

    private async Task ToggleAsync(int noticeId)
    {
        busy = noticeId;
        try
        {
            if (await Store.ToggleAsync(noticeId, CancellationToken.None)) favorites.Add(noticeId);
            else favorites.Remove(noticeId);
        }
        catch (KeyNotFoundException ex)
        {
            Logger.LogWarning(ex, "관심 공고 담기 실패: {NoticeId}", noticeId);
        }
        finally
        {
            busy = null;
        }
    }
}
