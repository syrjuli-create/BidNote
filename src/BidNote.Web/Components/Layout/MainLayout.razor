@inherits LayoutComponentBase
@using BidNote.Infrastructure.G2B
@using Microsoft.Extensions.Options
@inject IOptions<G2BOptions> G2B
@inject NavigationManager Nav
@implements IDisposable

<header class="topbar">
    <div class="in">
        <a class="logo" href="/"><span class="mark">입</span>입찰노트</a>
        <nav class="mainnav" aria-label="대메뉴">
            @foreach (var (href, name, prefixes) in Menus)
            {
                <a href="@href" class="@(IsActive(prefixes) ? "active" : null)" aria-current="@(IsActive(prefixes) ? "page" : null)">@name</a>
            }
        </nav>
        <div class="userbox">
            @if (G2B.Value.UseFakeData)
            {
                <span class="sample" title="나라장터 API 키를 받기 전이라 가상 공고를 보여 줍니다">가상 데이터</span>
            }
            <a class="btn-ghost" href="/status">수집 현황</a>
            <a class="btn-ghost" href="/me">내 정보</a>
        </div>
    </div>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    오류가 발생했습니다.
    <a href="." class="reload">새로고침</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // 공고 찾기는 메인("/", 진행 공고)과 /notices 아래(공고 상세·개찰 결과)를 함께 켠다. "="로 시작하면 그 주소만.
    private static readonly (string Href, string Name, string[] Prefixes)[] Menus =
    [
        ("/", "공고 찾기", ["=/", "/notices"]),
        ("/mine", "내 입찰", ["/mine"]),
        ("/tools", "입찰 도구", ["/tools"]),
        ("/alerts", "알림", ["/alerts"]),
        ("/library", "자료실", ["/library"]),
        ("/help", "고객센터", ["/help"]),
        ("/me", "내 정보", ["/me"]),
    ];

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private bool IsActive(string[] prefixes)
    {
        string path = new Uri(Nav.Uri).AbsolutePath;
        return prefixes.Any(p => p.StartsWith('=') ? path == p[1..] : path == p || path.StartsWith(p + "/", StringComparison.Ordinal));
    }
}
