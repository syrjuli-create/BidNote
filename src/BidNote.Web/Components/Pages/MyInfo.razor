@page "/me"
@rendermode InteractiveServer
@using System.Globalization
@using BidNote.Application.Company
@using BidNote.Domain.Company
@using BidNote.Domain.Notices
@inject ICompanyStore Store
@inject TimeProvider Clock

<PageTitle>내 정보 · 입찰노트</PageTitle>

<div class="stack">
    <div class="listhead"><h1>회사·면허 정보</h1></div>

    <section class="panel">
        <h2 class="sub">보유 면허</h2>
        @if (info is null)
        {
            <p class="tsub">불러오는 중입니다.</p>
        }
        else
        {
            @if (info.Licenses.Count == 0)
            {
                <p class="tsub">아직 등록한 면허가 없습니다. 나라장터 면허 제한 이름과 같게 골라야 공고와 맞춰 볼 수 있습니다.</p>
            }
            else
            {
                <div class="tbl">
                    <table class="licamounts">
                        <thead>
                            <tr><th>면허</th><th class="r">시공능력평가액(억)</th><th class="r">최근 실적 합계(억)</th><th class="r">실적 배수</th><th class="r">금액 상한</th><th>주력분야 (쉼표로 구분)</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var l in info.Licenses)
                            {
                                var d = Draft(l);
                                <tr>
                                    <td><span class="lic">@l.Name</span></td>
                                    <td class="r"><input class="in num" inputmode="decimal" aria-label="@(l.Name) 시공능력평가액(억 원)" placeholder="예: 35.2" @bind="d.Capacity" /></td>
                                    <td class="r"><input class="in num" inputmode="decimal" aria-label="@(l.Name) 최근 실적 합계(억 원)" placeholder="예: 120" @bind="d.Performance" /></td>
                                    <td class="r"><input class="in num" inputmode="decimal" aria-label="@(l.Name) 실적 배수" placeholder="예: 1" @bind="d.Multiple" /></td>
                                    <td class="r num">@(l.AmountLimit is { } limit ? Display.Eok(limit) : "-")</td>
                                    <td>
                                        <input class="in mainfields" aria-label="@(l.Name) 주력분야" placeholder="예: 포장공사" @bind="d.MainFields" />
                                        @if (mainFieldOptions.TryGetValue(l.Name, out var seen) && seen.Count > 0)
                                        {
                                            <span class="tsub">공고에 나온 것: @string.Join(", ", seen.Take(6))</span>
                                        }
                                    </td>
                                    <td class="nw">
                                        <button type="button" class="pill" disabled="@busy" @onclick="() => SaveAmountsAsync(l.Name)">저장</button>
                                        <button type="button" class="pill danger" aria-label="@(l.Name) 빼기" disabled="@busy" @onclick="() => RemoveAsync(l.Name)">빼기</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="tsub">금액 상한 = 시공능력평가액과 "실적 ÷ 실적 배수" 중 작은 값입니다(넣은 값만으로 계산). 공고 추정가격이 이 상한을 넘으면 참여 가능에서 뺍니다. 실적 배수는 발주처·금액대마다 다르니 공고문·적격심사 기준을 보고 넣으세요. 금액을 비우면 면허만 따집니다. 주력분야는 공고 상세에 맞는지만 알려 주고 참여 가능에서 빼지는 않습니다.</p>
            }
            <div class="row" style="margin-top:12px">
                <input class="in" list="license-options" placeholder="면허 이름 (예: 지반조성ㆍ포장공사업)" aria-label="추가할 면허"
                       maxlength="@CompanyLicense.MaxNameLength" @bind="newLicense" @bind:event="oninput" @onkeyup="OnKeyUpAsync" />
                <button type="button" class="btn" disabled="@(busy || newLicense.Trim().Length == 0)" @onclick="AddAsync">추가</button>
            </div>
            <datalist id="license-options">
                @foreach (var o in options.Where(o => !info.LicenseNames.Contains(o.Name)))
                {
                    <option value="@o.Name">진행 공고 @(o.OpenNoticeCount)건</option>
                }
            </datalist>
            @if (licenseStatus.Length > 0) { <p class="tsub" role="status">@licenseStatus</p> }

            @if (summary is { } s && info.HasLicenses)
            {
                <dl class="kv" style="margin-top:12px">
                    <div class="big"><dt>내 면허·금액·지역으로 참여 가능</dt><dd class="num"><a href="/?mine=true">진행 공고 @N(s.Eligible)건 보기 →</a>@if (s.RegionUnknown > 0) {<span class="tsub"> (그중 @N(s.RegionUnknown)건은 소재지 확인 필요)</span>}@if (s.MainFieldMismatch > 0) {<span class="tsub"> (그중 @N(s.MainFieldMismatch)건은 주력분야가 다름)</span>}</dd></div>
                    <div><dt>면허는 맞지만 금액 상한 초과</dt><dd class="num">@N(s.OverLimit)건</dd></div>
                    <div><dt>면허·금액은 맞지만 참가 가능 지역 밖</dt><dd class="num">@N(s.OutsideRegion)건</dd></div>
                    <div><dt>면허가 맞지 않는 공고</dt><dd class="num">@N(s.NotEligible)건</dd></div>
                    <div><dt>면허 제한 정보 없음</dt><dd class="num">@N(s.Unknown)건</dd></div>
                </dl>
                <p class="tsub">공고의 면허 제한 중 한 줄(그룹)의 면허를 모두 갖추면 면허는 맞는 것으로 봅니다. 토목건축공사업처럼 대신 인정하는 업종도 따집니다. 금액은 공고 추정가격을 금액 상한과 비교하고(추정가격이 없으면 면허만 봄), 지역은 공고의 참가 가능 지역 중 한 곳에 본사나 지사가 있는지 봅니다. 판단할 수 없는 것은 빼지 않습니다.</p>
            }
        }
    </section>

    <section class="panel">
        <h2 class="sub">본사·지사 소재지</h2>
        @if (info is not null)
        {
            @if (info.Locations.Count == 0)
            {
                <p class="tsub">아직 없습니다. 공고의 참가 가능 지역은 대부분 시군구 단위라 "충청북도 충주시"처럼 시군구까지 넣어야 정확히 판정합니다.</p>
            }
            else
            {
                <div class="licenses">
                    @foreach (var l in info.Locations)
                    {
                        <span class="lic">@l.Name@(l.IsHeadOffice ? " (본사)" : "") <button type="button" class="x" aria-label="@(l.Name) 빼기" disabled="@busy" @onclick="() => RemoveLocationAsync(l.Name)">×</button></span>
                    }
                </div>
            }
            <div class="row" style="margin-top:12px">
                <input class="in" list="location-options" placeholder="소재지 (예: 충청북도 충주시)" aria-label="추가할 소재지"
                       maxlength="@CompanyLocation.MaxNameLength" @bind="newLocation" @bind:event="oninput" @onkeyup="OnLocationKeyUpAsync" />
                <label class="check"><input type="checkbox" @bind="newLocationIsHead" /> 본사</label>
                <button type="button" class="btn" disabled="@(busy || newLocation.Trim().Length == 0)" @onclick="AddLocationAsync">추가</button>
            </div>
            <datalist id="location-options">
                @foreach (var o in locationOptions.Where(o => info.Locations.All(l => l.Name != o.Name)))
                {
                    <option value="@o.Name">진행 공고 @(o.OpenNoticeCount)건</option>
                }
            </datalist>
            @if (locationStatus.Length > 0) { <p class="tsub" role="status">@locationStatus</p> }
            <p class="tsub">공고의 지역 제한 판단 기준은 대부분 "본사 또는 참여 지사 소재지"라 지사도 넣을 수 있습니다. 목록은 진행 공고의 참가 가능 지역에 나온 이름입니다.</p>
        }
    </section>

    <section class="panel">
        <h2 class="sub">회사 정보</h2>
        <div class="formgrid">
            <label class="f">회사명<input class="in" maxlength="@CompanyProfile.MaxNameLength" @bind="form.Name" /></label>
            <label class="f">사업자번호<input class="in" inputmode="numeric" placeholder="000-00-00000" maxlength="@CompanyProfile.MaxBizNoLength" @bind="form.BizNo" /></label>
            <label class="f">이메일<input class="in" type="email" maxlength="@CompanyProfile.MaxEmailLength" @bind="form.Email" /></label>
        </div>
        <div class="row" style="margin-top:12px">
            <button type="button" class="btn" disabled="@busy" @onclick="SaveProfileAsync">저장</button>
            <span class="tsub" style="display:inline" role="status">@profileStatus</span>
        </div>
        <p class="tsub">이 PC의 DB에만 저장합니다. 주민등록번호 같은 개인 식별 정보는 받지 않습니다.</p>
    </section>
</div>

@code {
    private CompanyInfo? info;
    private IReadOnlyList<LicenseOption> options = [];
    private IReadOnlyList<LocationOption> locationOptions = [];
    private string newLocation = "", locationStatus = "";
    private bool newLocationIsHead;

    private static string N(int n) => n.ToString("N0", CultureInfo.InvariantCulture);
    private EligibilitySummary? summary;
    private Form form = new();
    private string newLicense = "", licenseStatus = "", profileStatus = "";
    private bool busy;

    private sealed class Form
    {
        public string Name { get; set; } = "";
        public string BizNo { get; set; } = "";
        public string Region { get; set; } = "";
        public string Email { get; set; } = "";
    }

    /// <summary>면허 한 줄의 금액 입력칸 (억 원 단위 글자 그대로). 저장하면 다시 채운다.</summary>
    private sealed class AmountDraft
    {
        public string Capacity { get; set; } = "";
        public string Performance { get; set; } = "";
        public string Multiple { get; set; } = "";
        public string MainFields { get; set; } = "";
    }

    private IReadOnlyDictionary<string, IReadOnlyList<string>> mainFieldOptions = new Dictionary<string, IReadOnlyList<string>>();

    private const decimal Eok = 100_000_000m;
    private readonly Dictionary<string, AmountDraft> drafts = new(StringComparer.Ordinal);

    private AmountDraft Draft(CompanyLicenseInfo l)
    {
        if (!drafts.TryGetValue(l.Name, out var d))
        {
            d = new AmountDraft
            {
                Capacity = l.CapacityAmount is { } c ? (c / Eok).ToString("0.####", CultureInfo.InvariantCulture) : "",
                Performance = l.PerformanceAmount is { } p ? (p / Eok).ToString("0.####", CultureInfo.InvariantCulture) : "",
                Multiple = l.PerformanceMultiple is { } m ? m.ToString("0.##", CultureInfo.InvariantCulture) : "",
                MainFields = string.Join(", ", l.MainFields),
            };
            drafts[l.Name] = d;
        }
        return d;
    }

    /// <summary>빈칸은 null, 숫자가 아니면 false.</summary>
    private static bool TryNumber(string text, out decimal? value)
    {
        value = null;
        string t = (text ?? "").Replace(",", "", StringComparison.Ordinal).Trim();
        if (t.Length == 0) return true;
        if (!decimal.TryParse(t, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal v) || v < 0) return false;
        value = v;
        return true;
    }

    private async Task SaveAmountsAsync(string name)
    {
        var d = drafts[name];
        if (!TryNumber(d.Capacity, out var capacity) || !TryNumber(d.Performance, out var performance) || !TryNumber(d.Multiple, out var multiple))
        {
            licenseStatus = $"'{name}'의 금액은 숫자로 넣어 주세요 (억 원 단위, 예: 35.2).";
            return;
        }
        busy = true;
        await Store.SaveLicenseAmountsAsync(name, new LicenseAmountsInput(
            capacity is { } c ? (long)Math.Round(c * Eok) : null,
            performance is { } p ? (long)Math.Round(p * Eok) : null,
            multiple is { } m ? (double)m : null), CancellationToken.None);
        await Store.SaveLicenseMainFieldsAsync(name, d.MainFields.Split([',', '，'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries), CancellationToken.None);
        drafts.Remove(name);
        await LoadAsync();
        var saved = info!.Licenses.First(x => x.Name == name);
        licenseStatus = saved.AmountLimit is { } limit
            ? $"'{name}' 금액을 저장했습니다. 금액 상한 {Display.Eok(limit)}."
            : $"'{name}' 금액을 저장했습니다. 상한을 계산할 값이 없어 면허만 따집니다 (실적은 배수와 함께 넣어야 합니다).";
        busy = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        form = new Form { Name = info!.Name, BizNo = info.BizNo, Region = info.Region, Email = info.Email };
        options = await Store.LicenseOptionsAsync(Clock.GetLocalNow().DateTime, CancellationToken.None);
        locationOptions = await Store.LocationOptionsAsync(Clock.GetLocalNow().DateTime, CancellationToken.None);
        mainFieldOptions = await Store.MainFieldOptionsAsync(Clock.GetLocalNow().DateTime, CancellationToken.None);
        newLocationIsHead = info.Locations.Count == 0;
    }

    private async Task OnLocationKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !busy && newLocation.Trim().Length > 0) await AddLocationAsync();
    }

    private async Task AddLocationAsync()
    {
        busy = true;
        string name = newLocation.Trim();
        // 시도로만 제한하는 공고가 많아 "대전광역시 서구"는 목록에 없어도 "대전광역시"가 있으면 맞는 이름으로 본다.
        string province = name.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
        bool known = locationOptions.Any(o => o.Name == name || o.Name == province || o.Name.StartsWith(province + " ", StringComparison.Ordinal));
        bool added = await Store.AddLocationAsync(name, newLocationIsHead, CancellationToken.None);
        locationStatus = !added ? $"'{name}'은(는) 이미 있습니다."
            : !name.Contains(' ') ? $"'{name}'을(를) 넣었습니다. 시도만 넣으면 시군구로 제한한 공고는 판단할 수 없으니 시군구까지 넣어 주세요."
            : known ? $"'{name}'을(를) 넣었습니다."
            : $"'{name}'을(를) 넣었습니다. 진행 공고의 참가 가능 지역에 없는 이름이니 나라장터 표기(예: 강원특별자치도 원주시)와 같은지 확인하세요.";
        newLocation = "";
        await LoadAsync();
        newLocationIsHead = info!.Locations.Count == 0;
        busy = false;
    }

    private async Task RemoveLocationAsync(string name)
    {
        busy = true;
        await Store.RemoveLocationAsync(name, CancellationToken.None);
        locationStatus = $"'{name}'을(를) 뺐습니다.";
        await LoadAsync();
        busy = false;
    }

    private async Task LoadAsync()
    {
        info = await Store.GetAsync(CancellationToken.None);
        summary = info.HasLicenses ? await Store.SummaryAsync(Clock.GetLocalNow().DateTime, CancellationToken.None) : null;
    }

    private async Task OnKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !busy && newLicense.Trim().Length > 0) await AddAsync();
    }

    private async Task AddAsync()
    {
        busy = true;
        string name = newLicense.Trim();
        bool known = options.Any(o => o.Name == name);
        bool added = await Store.AddLicenseAsync(name, CancellationToken.None);
        licenseStatus = !added ? $"'{name}'은(는) 이미 등록돼 있습니다."
            : known ? $"'{name}'을(를) 등록했습니다."
            : $"'{name}'을(를) 등록했습니다. 진행 중 공고의 면허 제한에는 없는 이름이니 철자를 확인하세요.";
        newLicense = "";
        await LoadAsync();
        busy = false;
    }

    private async Task RemoveAsync(string name)
    {
        busy = true;
        await Store.RemoveLicenseAsync(name, CancellationToken.None);
        drafts.Remove(name);
        licenseStatus = $"'{name}'을(를) 뺐습니다.";
        await LoadAsync();
        busy = false;
    }

    private async Task SaveProfileAsync()
    {
        busy = true;
        await Store.SaveProfileAsync(new CompanyProfileInput(form.Name, form.BizNo, form.Region, form.Email), CancellationToken.None);
        profileStatus = "저장했습니다.";
        await LoadAsync();
        busy = false;
    }
}
