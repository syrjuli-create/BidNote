@page "/"
@using BidNote.Application.Home
@inject IHomeQueries HomeQueries
@inject TimeProvider Clock
@inject NavigationManager Nav
@inject IConfiguration Config
@inject BidNote.Application.Favorites.IFavoriteStore Favorites
@inject ISavedSearchStore Searches
@inject BidNote.Application.Company.ICompanyStore Company

<PageTitle>입찰노트</PageTitle>

<form method="get" action="/" class="home">
    @if (!string.IsNullOrWhiteSpace(heroVideo))
    {
        <section class="hero" style="background-image: url('@heroPoster')">
            <video class="hero-video" autoplay muted loop playsinline poster="@heroPoster" aria-hidden="true">
                <source src="@heroVideo" type="video/webm" />
            </video>
            <div class="hero-text">
                <p class="eyebrow">@Display.DateText(now) 기준</p>
                <h1>오늘 참여할 공고를 찾아보세요</h1>
                @if (summary is not null)
                {
                    <p>진행 중 <b>@summary.ActiveCount</b>건 · 내일까지 마감 <b>@summary.ClosingSoonCount</b>건 · 새 공고 <b>@summary.NewCount</b>건</p>
                }
            </div>
        </section>
    }

    <section class="searchbar">
        <div class="searchfield">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input type="text" name="q" value="@Q" placeholder="공고명이나 발주기관으로 검색 (예: 화장실, ○○교육지원청)" aria-label="공고 검색어" />
        </div>
        <button class="btn" type="submit">검색</button>
        @if (Sort is not null) { <input type="hidden" name="sort" value="@Sort" /> }
    </section>

    <div class="layout">
        <aside class="panel filters" aria-label="공고 필터">
            <fieldset>
                <legend>지역</legend>
                @foreach (var r in result?.Regions ?? [])
                {
                    <label class="check"><input type="checkbox" name="region" value="@r.Value" checked="@(Region?.Contains(r.Value) == true)" /> @r.Value <span class="cnt">@r.Count</span></label>
                }
            </fieldset>
            <label class="f">업종(면허)
                <select name="license">
                    <option value="">전체 업종</option>
                    @foreach (var l in result?.Licenses ?? [])
                    {
                        <option value="@l.Value" selected="@(License == l.Value)">@l.Value (@l.Count)</option>
                    }
                </select>
            </label>
            <label class="f">계약방법
                <select name="contract">
                    <option value="">전체 계약방법</option>
                    @foreach (var c in result?.ContractMethods ?? [])
                    {
                        <option value="@c.Value" selected="@(Contract == c.Value)">@c.Value (@c.Count)</option>
                    }
                </select>
            </label>
            <label class="check"><input type="checkbox" name="nosu" value="true" checked="@(NoNegotiated == true)" /> 수의계약 빼고 보기</label>
            <label class="f">기초금액
                <select name="amount">
                    @foreach (var (v, t) in AmountOptions)
                    {
                        <option value="@v" selected="@(Amount == v)">@t</option>
                    }
                </select>
            </label>
            <label class="f">마감
                <select name="due">
                    @foreach (var (v, t) in DueOptions)
                    {
                        <option value="@v" selected="@(Due?.ToString() == v)">@t</option>
                    }
                </select>
            </label>
            <label class="check"><input type="checkbox" name="corrected" value="true" checked="@(Corrected == true)" /> 정정 공고만</label>
            <label class="check"><input type="checkbox" name="new" value="true" checked="@(IsNew == true)" /> 최근 5일 새 공고만</label>
            @if (myEligible is { } eligible)
            {
                <label class="check"><input type="checkbox" name="mine" value="true" checked="@(Mine == true)" /> 내 면허·금액으로 참여 가능 <span class="cnt">@eligible</span></label>
            }
            else
            {
                <p class="tsub"><a href="/me">내 정보</a>에 면허를 등록하면 참여 가능한 공고만 골라 볼 수 있습니다.</p>
            }
            <div class="row">
                <button class="btn" type="submit">적용</button>
                <a class="btn line" href="@ResetUrl">초기화</a>
            </div>
            <SavedSearchPanel Query="@currentQuery" @rendermode="InteractiveServer" />
        </aside>

        <section class="results">
            @if (summary is not null)
            {
                <nav class="quick" aria-label="빠른 보기">
                    <a href="@QuickUrl(null)" class="@(QuickCount == 0 ? "on" : "")"><b>@quick?.Active</b> 진행 중</a>
                    <a href="@QuickUrl("due")" class="hot @(Due == 1 && QuickCount == 1 ? "on" : "")"><b>@quick?.ClosingSoon</b> 내일까지 마감</a>
                    <a href="@QuickUrl("new")" class="@(IsNew == true && QuickCount == 1 ? "on" : "")"><b>@quick?.New</b> 새 공고</a>
                    <a href="@QuickUrl("corrected")" class="@(Corrected == true && QuickCount == 1 ? "on" : "")"><b>@quick?.Corrected</b> 정정</a>
                    <a href="/mine" class="fav"><b>@favCount</b> ★ 관심 공고</a>
                </nav>
            }

            <div class="listhead">
                <h2>공고 @(result?.TotalCount.ToString("N0") ?? "0")건
                    @if (result is { TotalCount: > 0 } shown)
                    {
                        <span class="tsub" style="display:inline">@((shown.Page - 1) * shown.PageSize + 1)–@Math.Min(shown.Page * shown.PageSize, shown.TotalCount)번째</span>
                    }
                </h2>
                <span class="sorts">
                    @foreach (var (v, t) in SortOptions)
                    {
                        <a href="@SortUrl(v)" class="@(CurrentSort == v ? "on" : "")">@t</a>
                    }
                </span>
            </div>

            @if (result is null)
            {
                <div class="empty">불러오는 중입니다.</div>
            }
            else if (summary?.ActiveCount == 0)
            {
                <div class="empty">아직 수집한 공고가 없습니다. 프로그램을 켜 두면 잠시 뒤 자동으로 수집합니다.</div>
            }
            else if (result.Items.Count == 0)
            {
                <div class="empty">조건에 맞는 공고가 없습니다. <a href="@ResetUrl">필터 초기화</a></div>
            }
            else
            {
                <NoticeTable Items="result.Items" FavoriteIds="favIds.ToArray()" Now="now" @rendermode="InteractiveServer" />
                @if (result.PageCount > 1)
                {
                    <nav class="pager" aria-label="페이지">
                        @if (result.Page > 1) { <a href="@PageUrl(result.Page - 1)" aria-label="이전 페이지">‹ 이전</a> }
                        @foreach (int p in PageNumbers(result.Page, result.PageCount))
                        {
                            if (p == 0) { <span class="gap">…</span> }
                            else if (p == result.Page) { <span class="cur" aria-current="page">@p</span> }
                            else { <a href="@PageUrl(p)">@p</a> }
                        }
                        @if (result.Page < result.PageCount) { <a href="@PageUrl(result.Page + 1)" aria-label="다음 페이지">다음 ›</a> }
                    </nav>
                }
            }

            @if (summary?.LastCollectedAt is { } last)
            {
                <p class="tsub">마지막 수집 @Display.DateTimeText(last)</p>
            }
        </section>
    </div>
</form>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "region")] public string[]? Region { get; set; }
    [SupplyParameterFromQuery(Name = "license")] public string? License { get; set; }
    [SupplyParameterFromQuery(Name = "amount")] public string? Amount { get; set; }
    [SupplyParameterFromQuery(Name = "due")] public int? Due { get; set; }
    [SupplyParameterFromQuery(Name = "corrected")] public bool? Corrected { get; set; }
    [SupplyParameterFromQuery(Name = "new")] public bool? IsNew { get; set; }
    [SupplyParameterFromQuery(Name = "contract")] public string? Contract { get; set; }
    [SupplyParameterFromQuery(Name = "nosu")] public bool? NoNegotiated { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNo { get; set; }
    [SupplyParameterFromQuery(Name = "reset")] public bool? Reset { get; set; }
    [SupplyParameterFromQuery(Name = "mine")] public bool? Mine { get; set; }

    /// <summary>내 면허로 참여 가능한 진행 공고 수. 면허를 등록하지 않았으면 null.</summary>
    private int? myEligible;
    private QuickCounts? quick;

    /// <summary>"/"만 열면 마지막 조건으로 돌아가므로, 필터를 비울 때는 이 주소로 마지막 조건까지 지운다.</summary>
    private const string ResetUrl = "/?reset=true";

    private string currentQuery = "";

    private HomeSummary? summary;
    private NoticeSearchResult? result;
    private DateTime now;
    private IReadOnlySet<int> favIds = new HashSet<int>();
    private int favCount;
    private string? heroVideo;
    private string? heroPoster;

    private static readonly (string Value, string Text)[] AmountOptions = [("", "전체 금액"), ("s", "1억 미만"), ("m", "1억~5억"), ("l", "5억 이상")];
    private static readonly (string Value, string Text)[] DueOptions = [("", "전체 기간"), ("0", "오늘 마감"), ("1", "내일까지"), ("3", "3일 이내"), ("7", "7일 이내")];
    private static readonly (string Value, string Text)[] SortOptions = [("due", "마감 임박순"), ("amount", "금액 높은순"), ("new", "최신 공고순")];

    private string PageUrl(int page) => Nav.GetUriWithQueryParameter("page", page == 1 ? null : page);

    /// <summary>정렬을 바꾸면 첫 페이지부터 본다.</summary>
    private string SortUrl(string sort) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["sort"] = sort, ["page"] = null });

    /// <summary>1 … 4 5 [6] 7 8 … 40 처럼 앞뒤 2개와 처음·끝만 보여 준다. 0은 생략 표시.</summary>
    public static IEnumerable<int> PageNumbers(int current, int count)
    {
        int last = 0;
        foreach (int p in Enumerable.Range(1, count).Where(p => p == 1 || p == count || Math.Abs(p - current) <= 2))
        {
            if (last != 0 && p - last == 2) yield return last + 1; // 한 쪽만 빠지면 "…" 대신 번호를 보여 준다
            else if (last != 0 && p - last > 2) yield return 0;
            yield return p;
            last = p;
        }
    }

    private string CurrentSort => Sort is "amount" or "new" ? Sort : "due";

    /// <summary>걸린 빠른 보기(마감·새 공고·정정) 수. 타일 강조에 쓴다.</summary>
    private int QuickCount => (Due is null ? 0 : 1) + (Corrected == true ? 1 : 0) + (IsNew == true ? 1 : 0);

    /// <summary>
    /// 빠른 보기 타일 주소: 지금 조건(검색어·지역·업종 등)은 두고 빠른 보기만 <paramref name="kind"/> 하나로 바꾼다.
    /// 남는 조건이 없으면 "/"가 마지막 조건으로 넘어가므로 초기화 주소를 쓴다.
    /// </summary>
    private string QuickUrl(string? kind)
    {
        string url = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["due"] = kind == "due" ? 1 : null,
            ["new"] = kind == "new" ? "true" : null, // bool을 넘기면 "True"로 붙는다
            ["corrected"] = kind == "corrected" ? "true" : null,
            ["page"] = null,
        });
        return SearchQuery.Normalize(new Uri(url).Query).Length == 0 ? ResetUrl : url;
    }

    protected override async Task OnParametersSetAsync()
    {
        // 마지막 검색 조건: 필터 없이 "/"를 열면 되살리고, 조건을 쓰면 기억하고, 초기화하면 지운다.
        string rawQuery = new Uri(Nav.Uri).Query;
        if (Reset == true)
        {
            await Searches.SetLastAsync("", CancellationToken.None);
            Nav.NavigateTo("/", replace: true);
            return;
        }
        if (rawQuery.Length == 0)
        {
            string last = await Searches.GetLastAsync(CancellationToken.None);
            if (last.Length > 0)
            {
                Nav.NavigateTo("/?" + last, replace: true);
                return;
            }
        }
        currentQuery = SearchQuery.Normalize(rawQuery);
        if (rawQuery.Length > 0) await Searches.SetLastAsync(currentQuery, CancellationToken.None);

        now = Clock.GetLocalNow().DateTime;
        heroVideo = Config["Home:HeroVideo"];
        heroPoster = Config["Home:HeroPoster"];
        bool hasLicenses = (await Company.GetAsync(CancellationToken.None)).HasLicenses;
        var filter = new NoticeFilter
        {
            Keyword = Q,
            Regions = Region ?? [],
            License = License,
            ContractMethod = Contract,
            ExcludeNegotiated = NoNegotiated == true,
            Amount = Amount switch { "s" => AmountRange.Under100M, "m" => AmountRange.From100MTo500M, "l" => AmountRange.Over500M, _ => AmountRange.Any },
            DueWithinDays = Due is >= 0 ? Due : null,
            CorrectedOnly = Corrected == true,
            NewOnly = IsNew == true,
            MyLicensesOnly = Mine == true && hasLicenses, // 면허를 모두 지웠으면 저장된 조건의 mine은 무시한다
            Page = PageNo ?? 1,
            Sort = CurrentSort switch { "amount" => NoticeSort.AmountHigh, "new" => NoticeSort.Newest, _ => NoticeSort.DueSoon },
        };
        summary = await HomeQueries.GetSummaryAsync(now, CancellationToken.None);
        result = await HomeQueries.SearchAsync(filter, now, CancellationToken.None);
        quick = await HomeQueries.CountQuickAsync(filter, now, CancellationToken.None);
        favIds = await Favorites.FavoriteIdsAsync([.. result.Items.Select(x => x.Id)], CancellationToken.None);
        favCount = await Favorites.CountOpenAsync(now, CancellationToken.None);
        myEligible = hasLicenses ? (await Company.SummaryAsync(now, CancellationToken.None)).Eligible : null;
    }
}
