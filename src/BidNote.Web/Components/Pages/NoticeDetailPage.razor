@page "/notices/{Id:int}"
@using System.Globalization
@using System.Text.RegularExpressions
@using BidNote.Application.Notices
@using BidNote.Domain.Bidding
@using BidNote.Domain.Notices
@using BidNote.Domain.Company
@inject INoticeDetailQueries Queries
@inject BidNote.Application.Company.ICompanyStore Company
@inject TimeProvider Clock

<PageTitle>@(notice?.Name ?? "공고 상세") · 입찰노트</PageTitle>

<div class="stack detail">
    <a class="back" href="javascript:history.back()">← 목록으로</a>

    @if (notice is null)
    {
        <div class="empty">공고를 찾을 수 없습니다. 목록에서 다시 골라 주세요. <a href="/">메인 화면</a></div>
    }
    else
    {
        <header class="dhead">
            <div class="chips">
                <span class="dday @Display.DDayLevel(notice.DueAt, now)">@(notice.DueAt > now ? Display.DDay(notice.DueAt, now) : "마감")</span>
                @if (!notice.IsActive) { <span class="chip warn">취소 공고</span> }
                @if (notice.CorrectionCount > 0) { <span class="chip warn">정정 @(notice.CorrectionCount)차</span> }
                @if (notice.IsRebid) { <span class="chip warn">재공고</span> }
                @if (notice.PostedAt >= now - BidNote.Application.Home.HomeRules.NewWindow) { <span class="chip new">새 공고</span> }
            </div>
            <h1>@notice.Name</h1>
            <p class="tsub">@notice.Agency · <span class="num">@notice.BidNo-@notice.BidSeq</span> · 마지막 확인 @Display.DateTimeText(notice.LastCheckedAt)</p>
            @if (notice.DetailUrl.Length > 0)
            {
                <a class="btn" href="@notice.DetailUrl" target="_blank" rel="noopener">나라장터 원문 보기</a>
            }
            <a class="btn line" href="/tools/calc?notice=@notice.Id">이 공고로 계산</a>
        </header>

        <FavoritePanel NoticeId="notice.Id" @rendermode="InteractiveServer" />

        <div class="dgrid">
            <section class="panel">
                <h2 class="sub">일정·기관</h2>
                <dl class="kv">
                    <div><dt>입찰 마감</dt><dd class="num">@Display.DateTimeText(notice.DueAt)</dd></div>
                    <div><dt>개찰 일시</dt><dd class="num">@Display.DateTimeText(notice.OpenAt)</dd></div>
                    <div><dt>공고일</dt><dd class="num">@Display.DateTimeText(notice.PostedAt)</dd></div>
                    <div><dt>발주기관</dt><dd>@notice.Agency</dd></div>
                    <div><dt>수요기관</dt><dd>@Or(notice.DemandAgency)</dd></div>
                    <div><dt>현장 지역</dt><dd>@Or(notice.SiteRegionName)</dd></div>
                    <div><dt>참가 가능 지역</dt><dd>@(notice.RegionLimits.Count == 0 ? "제한 없음 (또는 아직 받지 않음)" : string.Join(" 또는 ", notice.RegionLimits))
                        @if (eligibility?.Region == RegionVerdict.Within) { <span class="chip ok">내 소재지 포함</span> }
                        else if (eligibility?.Region == RegionVerdict.Outside) { <span class="chip warn">내 소재지 밖</span> }
                        else if (eligibility?.Region == RegionVerdict.Unknown && notice.RegionLimits.Count > 0) { <span class="chip">소재지 확인 필요</span> }
                    </dd></div>
                    @foreach (var e in notice.Extras.Where(e => !MoneyLabels.Contains(e.Label)))
                    {
                        <div><dt>@e.Label</dt><dd>@e.Value</dd></div>
                    }
                </dl>
            </section>

            <section class="panel">
                <h2 class="sub">금액</h2>
                <dl class="kv">
                    <div class="big"><dt>기초금액</dt><dd class="num">@(notice.BasePrice is { } b ? Display.Won(b) + "원" : "미공개")</dd></div>
                    <div><dt>예비가격 범위</dt><dd>@Or(notice.ReservePriceRange)</dd></div>
                    <div><dt>낙찰하한율</dt><dd class="num">@(notice.LowerLimitRate > 0 ? notice.LowerLimitRate.ToString("0.###", CultureInfo.InvariantCulture) + "%" : "-")</dd></div>
                    <div><dt>A값</dt><dd class="num">@(notice.AValue is { } a ? Display.Won(a) + "원" : "적용 안 함")</dd></div>
                    <div><dt>순공사원가</dt><dd class="num">@(notice.NetCost is { } net ? Display.Won(net) + "원" : "-")</dd></div>
                    <div><dt>기초금액 공개</dt><dd class="num">@(notice.BasePriceOpenedAt is { } o ? Display.DateTimeText(o) : "-")</dd></div>
                    @foreach (var e in notice.Extras.Where(e => MoneyLabels.Contains(e.Label)))
                    {
                        <div><dt>@e.Label</dt><dd class="num">@e.Value</dd></div>
                    }
                </dl>
                @if (notice.CostItems.Any(x => x.Amount > 0))
                {
                    <details class="aitems" open="@(notice.AValue is not null)">
                        <summary>A값 내역 <span class="tsub" style="display:inline">나라장터 기초금액 상세와 비교해 보세요</span></summary>
                        <table class="mini">
                            <tbody>
                                @foreach (var c in notice.CostItems.Where(x => x.Amount > 0 || x.InAValue))
                                {
                                    <tr class="@(c.InAValue ? "" : "muted")">
                                        <td>@c.Label@(c.InAValue ? "" : " (A값 아님)")</td>
                                        <td class="r num">@Display.Won(c.Amount)원</td>
                                        <td class="r num tsub">@(notice.BasePrice is > 0 && c.Amount > 0 ? (c.Amount * 100.0 / notice.BasePrice.Value).ToString("0.00", CultureInfo.InvariantCulture) + "%" : "")</td>
                                    </tr>
                                }
                            </tbody>
                            @if (notice.AValue is { } sum)
                            {
                                <tfoot>
                                    <tr><th>A값 합계</th><td class="r num">@Display.Won(sum)원</td><td class="r num tsub">@(notice.BasePrice is > 0 ? (sum * 100.0 / notice.BasePrice.Value).ToString("0.00", CultureInfo.InvariantCulture) + "%" : "")</td></tr>
                                </tfoot>
                            }
                        </table>
                        @if (notice.AValue is { } s2 && notice.BasePrice is > 0 && s2 * 100.0 / notice.BasePrice.Value > 20)
                        {
                            <p class="tsub warn-text">A값이 기초금액의 20%를 넘습니다. 보통은 5% 안팎이니 공고문 금액을 꼭 확인하세요.</p>
                        }
                    </details>
                }
            </section>
        </div>

        <section class="panel">
            <h2 class="sub">면허(업종) 제한
                @if (eligibility is { Kind: EligibilityKind.Eligible, Region: RegionVerdict.Outside })
                {
                    <span class="chip warn">면허는 맞지만 참가 가능 지역 밖</span>
                }
                else if (eligibility is { Kind: EligibilityKind.Eligible })
                {
                    <span class="chip ok">내 면허로 참여 가능</span>
                }
                else if (eligibility is { Kind: EligibilityKind.NotEligible } ne)
                {
                    <span class="chip warn">면허 부족: @string.Join(", ", ne.Missing)</span>
                }
            </h2>
            @if (notice.Licenses.Count == 0)
            {
                <p class="tsub">면허 제한 정보가 없습니다.@(notice.License.Length > 0 ? $" 대표 업종: {notice.License}" : "")</p>
            }
            else
            {
                <div class="lgroups">
                    @for (int i = 0; i < notice.Licenses.Count; i++)
                    {
                        var g = notice.Licenses[i];
                        @if (i > 0) { <span class="or">또는</span> }
                        <div class="lgroup @(eligibility?.GroupNo == g.GroupNo ? "near" : "")">
                            @for (int j = 0; j < g.Items.Count; j++)
                            {
                                var item = g.Items[j];
                                @if (j > 0) { <span class="and">그리고</span> }
                                <span class="lic">@item.Name@if (item.Alternatives.Count > 0) {<span class="alt"> (@string.Join(", ", item.Alternatives)도 인정)</span>}@if (item.MainFields.Count > 0) {<span class="alt"> · 주력분야 @string.Join(" 또는 ", item.MainFields.Select(g => string.Join("+", g)))</span>}</span>
                            }
                        </div>
                    }
                </div>
                @if (eligibility?.MainField == MainFieldVerdict.Mismatch)
                {
                    <p class="tsub warn-text">주력분야가 내 정보에 넣은 주력분야와 다릅니다. 주력분야가 참가 자격 제한인지 공고문을 확인하세요.</p>
                }
                else if (eligibility?.MainField == MainFieldVerdict.Unknown)
                {
                    <p class="tsub"><a href="/me">내 정보</a>에 이 면허의 주력분야를 넣으면 맞는지 알려 드립니다.</p>
                }
                <p class="tsub">한 줄 안의 면허는 모두 갖춰야 하고, 줄이 여러 개면 그중 한 줄만 갖추면 됩니다. 주력분야는 참고로만 보여 주고 참여 가능 판정에는 넣지 않으니 정확한 조건은 공고문을 확인하세요.</p>
                @if (eligibility is null)
                {
                    <p class="tsub"><a href="/me">내 정보</a>에 면허를 등록하면 참여할 수 있는지 바로 알려 드립니다.</p>
                }
            }
        </section>

        <section class="panel screening">
            <h2 class="sub">적격심사 참고 <span class="tsub">@(local ? LocalScreeningRules.Source : ScreeningRules.Source) 기준</span></h2>
            @if (notice.PerformanceLimited)
            {
                <p class="warn-text"><b>실적제한 공고입니다.</b> 공고문에 정한 실적이 없으면 참여할 수 없습니다. 요구 실적은 나라장터 API에 없으니 공고문을 확인하세요.@(notice.PerformanceDocDueAt is { } docDue ? $" 실적 증명 서류 접수 마감 {Display.DateTimeText(docDue)}" : "")@(notice.PerformanceDocMethod.Length > 0 ? $" ({notice.PerformanceDocMethod})" : "")</p>
            }
            @if (local)
            {
                @if (localBand is null)
                {
                    <p class="tsub">@(notice.EstimatedPrice is null ? "추정가격이 없어 금액 구간을 정할 수 없습니다." : "추정가격 300억 원 이상은 적격심사 대상이 아닙니다.")</p>
                }
                else
                {
                    @if (localExperience is { } lx)
                    {
                        <p class="@(lx.Points < lx.MaxPoints ? "warn-text" : "")">
                            시공경험 예상 <b class="num">@lx.Points.ToString("0.##", CultureInfo.InvariantCulture) / @lx.MaxPoints.ToString("0.##", CultureInfo.InvariantCulture)점</b>
                            @(lx.Grade.Length > 0 ? $"({lx.Grade}등급)" : "")
                            — @(lx.PeriodLabel) 실적 ÷ 추정가격 = <span class="num">@lx.RatioPercent.ToString("0.#", CultureInfo.InvariantCulture)%</span>, @lx.TableTitle
                        </p>
                        <p class="tsub">업종 하나로 입찰한다고 보고(업종평가비율 100%) 계산했습니다. 복합 업종·주계약자 관리방식·실적제한 입찰이면 공고문의 업종별 추정가격으로 다시 확인하세요. @(localMine is { } lm ? $"계산에 쓴 면허: {lm.Name}" : "")</p>
                    }
                    else if (localBand.Kind == LocalExperienceMethod.NotEstimated)
                    {
                        <p class="tsub">이 구간은 원문 산식이 복잡해 예상 점수를 계산하지 않습니다.</p>
                    }
                    else
                    {
                        <p class="tsub"><a href="/me">내 정보</a>에 이 공고 면허의 @(localBand.Kind == LocalExperienceMethod.Grade5Years ? "최근 5년" : "최근 3년") 실적을 넣으면 시공경험 예상 점수를 계산합니다.</p>
                    }
                    <LocalBandView Band="localBand" MyRatio="localExperience?.RatioPercent" MyTableTitle="@(localExperience?.TableTitle)" MyUnderFourYears="localMine?.UnderFourYears == true && localBand.Kind != LocalExperienceMethod.Grade5Years" />
                }
            }
            else if (band is null)
            {
                <p class="tsub">@(notice.EstimatedPrice is null ? "추정가격이 없어 금액 구간을 정할 수 없습니다." : "추정가격 100억 원 이상은 적격심사가 아닌 종합심사낙찰제 등이라 이 표를 쓰지 않습니다.")</p>
            }
            else
            {
                <dl class="kv">
                    <div><dt>금액 구간</dt><dd>@band.Name@(band.Trade == ScreeningTrade.Special ? " (전기·정보통신·소방·국가유산)" : "")</dd></div>
                    <div><dt>시공경험</dt><dd>@(band.EvaluatesExperience ? $"{band.ExperiencePoints}점 · 실적 {ScreeningRules.PerformanceYears}년 · 배수 {Multiple(band.MultipleFor(civil))}배" : "평가 안 함")</dd></div>
                    <div><dt>입찰가격 배점</dt><dd class="num">@(band.PricePoints)점</dd></div>
                    <div><dt>기준 낙찰하한율</dt><dd class="num">@band.LowerLimitRate.ToString("0.###", CultureInfo.InvariantCulture)%@(notice.LowerLimitRate > 0 && Math.Abs(notice.LowerLimitRate - band.LowerLimitRate) > 0.0005 ? $" (이 공고 {notice.LowerLimitRate.ToString("0.###", CultureInfo.InvariantCulture)}% — 공고 기준이 다름)" : "")</dd></div>
                </dl>
                @if (band.EvaluatesExperience)
                {
                    @if (experience is { } x)
                    {
                        <p class="@(x.Full ? "" : "warn-text")">
                            시공경험 예상 <b class="num">@x.Points.ToString("0.##", CultureInfo.InvariantCulture) / @(x.Band.ExperiencePoints)점</b>
                            — 내 실적 @Display.Eok(x.Performance) / 만점 기준 @Display.Eok(x.RequiredPerformance) (기초금액 × @Multiple(x.Multiple)배)
                            @if (!x.Full) { <span>· 실적이 모자라 점수가 깎입니다. 입찰은 할 수 있습니다.</span> }
                        </p>
                    }
                    else
                    {
                        <p class="tsub"><a href="/me">내 정보</a>에 이 공고 면허의 최근 5년 실적을 넣으면 시공경험 예상 점수를 계산합니다.</p>
                    }
                }
            }
            <p class="tsub">참고용입니다. @(local ? "발주기관이 지방자치단체라 행정안전부 기준을 보여 줍니다. " : notice.Agency.Contains("조달청", StringComparison.Ordinal) ? "" : "조달청 발주가 아닌 국가기관·공기업 공고는 자체 기준이 조금 다를 수 있습니다. ")실제 심사는 공고문과 발주처 기준을 따릅니다. <a href="/tools/rates">투찰률·실적배수 표 보기</a></p>
        </section>

        <section class="panel">
            <h2 class="sub">사정률별 투찰금액 <span class="tsub">@RangeNote</span></h2>
            @if (notice.BasePrice is null)
            {
                <p class="tsub">기초금액이 공개되면 계산해 보여 줍니다.</p>
            }
            else if (notice.LowerLimitRate <= 0)
            {
                <p class="tsub">낙찰하한율 정보가 없어 계산할 수 없습니다.</p>
            }
            else
            {
                <div class="tbl">
                    <table>
                        <thead><tr><th class="r">사정률</th><th class="r">예정가격</th><th class="r">투찰금액</th><th>적용 산식</th></tr></thead>
                        <tbody>
                            @foreach (var (rate, calc) in BidRows())
                            {
                                <tr class="@(Math.Abs(rate - 100) < 0.001 ? "mid" : "")">
                                    <td class="r num">@rate.ToString("0.0", CultureInfo.InvariantCulture)%</td>
                                    <td class="r num">@Display.Won((long)Math.Round(calc.PlannedPrice))</td>
                                    <td class="r num"><b>@Display.Won(calc.BidAmount)</b></td>
                                    <td>@(calc.UsedNetCostFloor ? "순공사원가 하한" : calc.AValueAmount is not null ? "A값 적용" : "기본")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="tsub">투찰금액 = (기초금액 × 사정률 − A값) × 낙찰하한율 + A값, 원 단위 올림. 순공사원가 하한(× 98%)보다 낮으면 하한 금액. 참고용 계산이며 최종 금액은 공고문 기준을 따르세요.</p>
            }
        </section>

        <MyBidPanel NoticeId="notice.Id" BasePrice="notice.BasePrice" LowerLimitRate="notice.LowerLimitRate" AValue="notice.AValue"
                    NetCost="notice.NetCost" DueAt="notice.DueAt" @rendermode="InteractiveServer" />

        <BidResultPanel NoticeId="notice.Id" OpenAt="notice.OpenAt" @rendermode="InteractiveServer" />

        <section class="panel">
            <h2 class="sub">정정 이력</h2>
            @if (notice.Changes.Count == 0)
            {
                <p class="tsub">수집한 뒤로 바뀐 내용이 없습니다.</p>
            }
            else
            {
                <ol class="timeline">
                    @foreach (var c in notice.Changes)
                    {
                        <li>
                            <div class="when num">@Display.DateTimeText(c.DetectedAt)</div>
                            <div>
                                <b>@ChangeText(c.Type)</b> <span class="tsub num" style="display:inline">차수 @c.FromSeq → @c.ToSeq</span>
                                @if (c.Fields.Count == 0)
                                {
                                    <p class="tsub">주요 항목 외의 내용이 바뀌었습니다 (첨부 문서 등). 원문에서 확인하세요.</p>
                                }
                                else
                                {
                                    <ul class="changes">
                                        @foreach (var f in c.Fields)
                                        {
                                            <li><span class="lbl">@f.Label</span> <s>@f.Before</s> → <b>@f.After</b></li>
                                        }
                                    </ul>
                                }
                            </div>
                        </li>
                    }
                </ol>
            }
        </section>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private NoticeDetail? notice;
    private Eligibility? eligibility;
    private ScreeningBand? band;
    private ExperienceEstimate? experience;
    private bool civil;
    private bool local;
    private LocalScreeningBand? localBand;
    private LocalExperienceEstimate? localExperience;
    private BidNote.Application.Company.CompanyLicenseInfo? localMine;
    private DateTime now;
    private static readonly HashSet<string> MoneyLabels = ["예산금액", "추정가격"];

    protected override async Task OnParametersSetAsync()
    {
        now = Clock.GetLocalNow().DateTime;
        notice = await Queries.GetAsync(Id, CancellationToken.None);
        eligibility = notice is null ? null : await Company.CheckAsync(Id, CancellationToken.None);
        if (notice is null) return;

        var names = notice.Licenses.SelectMany(g => g.Items.Select(i => i.Name)).Append(notice.License).Where(n => n.Length > 0).Distinct().ToList();
        band = ScreeningRules.BandFor(notice.EstimatedPrice, ScreeningRules.TradeOf(names));
        // 시공경험은 참여에 쓰는 면허의 실적으로 본다: 충족한(또는 가장 가까운) 그룹의 면허 중 내가 실적을 넣은 것의 가장 큰 값.
        var company = await Company.GetAsync(CancellationToken.None);
        var group = notice.Licenses.FirstOrDefault(g => g.GroupNo == eligibility?.GroupNo) ?? notice.Licenses.FirstOrDefault();
        List<string> groupNames = group is null ? (notice.License.Length > 0 ? [notice.License] : []) : [.. group.Items.SelectMany(i => i.Alternatives.Prepend(i.Name))];
        var mine = company.Licenses.Where(l => groupNames.Contains(l.Name) && l.PerformanceAmount is > 0).OrderByDescending(l => l.PerformanceAmount).FirstOrDefault();
        civil = (mine?.Name ?? groupNames.FirstOrDefault() ?? "") == "토목공사업";
        experience = ScreeningRules.EstimateExperience(band, notice.BasePrice, notice.EstimatedPrice, mine?.PerformanceAmount, civil);

        // 지자체 발주는 행정안전부 기준: 실적을 추정가격 대비 비율 등급으로 본다 (점수는 계산하지 않고 표에 비율만 표시).
        local = LocalScreeningRules.IsLocalAgency(notice.Agency);
        localBand = local ? LocalScreeningRules.BandFor(notice.EstimatedPrice) : null;
        if (localBand is not null)
        {
            // 이 구간이 쓰는 실적(5년/3년)을 넣은 면허 중 실적이 가장 큰 것으로 본다.
            bool five = localBand.Kind == LocalExperienceMethod.Grade5Years;
            localMine = company.Licenses
                .Where(l => groupNames.Contains(l.Name) && (five ? l.PerformanceAmount : l.RecentPerformanceAmount) is > 0)
                .OrderByDescending(l => five ? l.PerformanceAmount : l.RecentPerformanceAmount).FirstOrDefault();
            string license = localMine?.Name ?? groupNames.FirstOrDefault() ?? notice.License;
            localExperience = LocalScreeningRules.EstimateExperience(localBand, notice.EstimatedPrice, LocalScreeningRules.IsGeneralLicense(license),
                localMine?.PerformanceAmount, localMine?.RecentPerformanceAmount, localMine?.UnderFourYears == true);
        }
    }

    private static string Multiple(double m) => m.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Or(string s) => string.IsNullOrWhiteSpace(s) ? "-" : s;

    private (double Low, double High, bool Known) Range()
    {
        var m = Regex.Matches(notice!.ReservePriceRange, @"[-+]?\d+(\.\d+)?");
        if (m.Count >= 2
            && double.TryParse(m[0].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out double lo)
            && double.TryParse(m[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out double hi) && hi > lo)
            return (lo, hi, true);
        return (-3, 3, false);
    }

    private string RangeNote => notice is null ? "" : Range() is var r && r.Known
        ? $"(예비가격 범위 {r.Low:+0.#;-0.#}% ~ {r.High:+0.#;-0.#}% 안에서 0.5% 간격)"
        : "(예비가격 범위를 몰라 ±3%로 가정)";

    private IEnumerable<(double Rate, BidCalculation Calc)> BidRows()
    {
        var (low, high, _) = Range();
        for (double d = low; d <= high + 1e-9; d += 0.5)
        {
            double rate = 100 + d;
            yield return (rate, BidCalculator.Calculate(new BidInput(notice!.BasePrice!.Value, rate, notice.LowerLimitRate, notice.AValue ?? 0, notice.NetCost ?? 0)));
        }
    }

    private static string ChangeText(NoticeChangeType t) => t switch
    {
        NoticeChangeType.Corrected => "정정 공고",
        NoticeChangeType.Rebid => "재공고",
        NoticeChangeType.Cancelled => "취소 공고",
        _ => "내용 변경",
    };
}
